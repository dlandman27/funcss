{
  "framework": null,
  "outputDirectory": ".",
  "redirects": [
    { "source": "/sites/:slug", "destination": "/:slug/", "permanent": true },
    { "source": "/sites/:slug/", "destination": "/:slug/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/:slug", "destination": "/sites/:slug/index.html" },
    { "source": "/:slug/", "destination": "/sites/:slug/index.html" },
    { "source": "/:slug/:path+", "destination": "/sites/:slug/:path+" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(png|jpg|jpeg|gif|webp|avif|svg|ico|mp3|wav|ogg|glb|gltf|woff|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }
      ]
    },
    {
      "source": "/globals/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/catalog.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
